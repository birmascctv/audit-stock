# ========================================================
# BIRMAS STOCK AUDIT - ENVIRONMENT CONFIGURATION
# ========================================================

# Server Port (matches systemd service, default: 3005 or 3000)
PORT=3005
NODE_ENV=production

# WordPress Pods Configuration
WP_URL=https://admin.birmas.id

# WordPress REST Endpoints for Pods
WP_STOCKS_ENDPOINT=/wp-json/api/v1/product_stocks?per_page=100
WP_LOCATIONS_ENDPOINT=/wp-json/api/v1/locations?per_page=100

# Optional: WordPress Basic Auth / Application Password (leave blank if public)
# Example: admin:abcd 1234 efgh 5678
WP_APP_PASSWORD=
